# 和风天气 API 配置
# 免费注册：https://dev.qweather.com/
# 免费订阅：https://dev.qweather.com/docs/finance/subscription/
# 注册后复制 API Key 填到下面

QWEATHER_KEY=your_api_key_here
QWEATHER_CITY=北京

# 设为 true 强制使用模拟数据（调试用）
# QWEATHER_MOCK=false

# DeepSeek API 配置（可选，用于 LLM 增强回复）
# 注册获取 API Key：https://platform.deepseek.com/api_keys
# 不配置则自动回退到模板回复，不影响功能

DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_MODEL=deepseek-chat
LLM_ENABLED=true
